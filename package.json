{
  "name": "allure-learning",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:bundle": "pnpm --package=@redocly/cli dlx redocly bundle ./src/shared/api/schema/main.yaml -o bundle.yaml",
    "api:gen": "pnpm dlx --package=openapi-typescript@7.13.0 --package=typescript@5.x openapi-typescript ./src/shared/api/schema/main.yaml -o ./src/shared/api/schema/generated.d.ts",
    "test:unit": "vitest run",
    "test:screenshot": "storybook",
    "test:e2e": "playwright",
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "allure:generate": "mkdir -p ./allure-results; allure generate --open"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.81.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "allure": "^3.16.0",
    "allure-js-commons": "^3.11.1",
    "allure-playwright": "^3.11.1",
    "allure-vitest": "^3.11.1",
    "eslint": "^10.9.1",
    "jose": "^6.2.12",
    "msw": "^2.15.0",
    "openapi-msw": "^2.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "create-gstore": "^0.2.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.41.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router": "^8.3.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "12.3.4"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
